---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import shareSource from '../assets/photos/class1.jpg';

interface Props {
  title: string;
  description: string;
  /** Review-only pages are never indexed and never listed in the sitemap. */
  reviewOnly?: boolean;
  current?: 'home' | 'videos' | 'privacy';
}

const { title, description, reviewOnly = false, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
const robots = site.allowIndexing && !reviewOnly ? 'index, follow' : 'noindex, nofollow';
const share = await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, site.origin).href;
const fullTitle = current === 'home' ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!reviewOnly && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#101e27" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Andrew Marshall leading a Tai Chi class in Colton Village Hall" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
