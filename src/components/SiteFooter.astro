---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { contact, site } from '../data/site';
---

<footer class="site-footer on-ink">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <Image src={logo} alt="" widths={[96, 192]} sizes="96px" class="site-footer__logo" />
      <p class="site-footer__name">{site.name}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/#classes">Classes</a></li>
        <li><a href="/video-demo.html">Practice videos</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
    <p class="site-footer__contact">
      <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
      {contact.phones.map((p, i) => (
        <>{i > 0 && ' · '}<a href={`tel:${p.tel}`}>{p.display}</a></>
      ))}
    </p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-5); font-size: 1rem; }
  .site-footer__inner {
    display: grid; gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  .site-footer__brand { display: flex; align-items: center; gap: var(--space-2); }
  .site-footer__logo {
    width: 96px; height: auto;
    background: var(--cream); border-radius: 50%; padding: 0.35rem;
  }
  .site-footer__name { font-family: var(--font-heading); font-weight: 700; font-size: 1.35rem; line-height: 1.2; margin: 0; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .site-footer a { color: var(--cream); }
  .site-footer__contact { margin: 0; line-height: 1.9; }

  @media (min-width: 48rem) {
    .site-footer__inner { grid-template-columns: 1.4fr 1fr 1.2fr; align-items: center; }
  }
</style>
